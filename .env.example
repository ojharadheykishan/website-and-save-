API_ID=
API_HASH=
BOT_TOKEN=
CHANNEL_ID=
CLONE_LOG_CHANNEL=
ARCHIVE_CHAT_ID=

# Optional persistent queue backend. If unset or unavailable, SQLite is used.
MONGODB_URI=
# Legacy alias for MONGODB_URI.
MONGO_DB=
MONGO_DATABASE=save_restricted_bot
MONGO_MAX_POOL_SIZE=20

# Mount a Railway volume at /app/data and point this path into the volume.
TASK_QUEUE_DB=./data/background_tasks.sqlite3
DOWNLOAD_CONCURRENCY=10
UPLOAD_CONCURRENCY=5
TASK_MAX_RETRIES=3
WORKER_SHUTDOWN_TIMEOUT=30
MEDIA_TEMP_DIR=/tmp/save-restricted-bot

# Optional default group for /batch -> NO. Per-user saved destinations take priority.
DEFAULT_DESTINATION_ID=

PYROGRAM_WORKERS=10
MAX_CONCURRENT_TRANSMISSIONS=2
PROGRESS_STICKER_FILE_ID=
PROGRESS_STICKER_CONFIG=./data/progress_sticker.json
PUBLIC_BASE_URL=
FLASK_SECRET_KEY=
YOUTUBE_API_KEY=
MAX_STREAM_FILE_SIZE_MB=5000
MAX_QUALITY_SOURCE_MB=750
STREAM_CACHE_DIR=
STREAM_LINKS_FILE=
STREAM_CATALOG_FILE=
PORT=5000

# Set strong values before exposing the website admin dashboard.
# If unset, the current legacy defaults are admin / admin123.
# STUDY_ADMIN_USERNAME=
# STUDY_ADMIN_PASSWORD=
